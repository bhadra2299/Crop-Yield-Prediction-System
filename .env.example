# Smart Crop AI - environment template. Copy to .env and fill in. Never commit .env.

# --- runtime -----------------------------------------------------------------
AGRI_ENV=development                 # development | staging | production
AGRI_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
AGRI_LOG_JSON=false                  # true in production (structured logs)
AGRI_API_HOST=0.0.0.0
AGRI_API_PORT=8000
AGRI_API_ROOT_PATH=
AGRI_CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- auth / limits -----------------------------------------------------------
# Comma-separated API keys. Empty disables auth (development only).
AGRI_API_KEYS=
AGRI_RATE_LIMIT_PER_MINUTE=60
AGRI_MAX_UPLOAD_BYTES=5242880        # 5 MiB

# --- external services -------------------------------------------------------
OPENWEATHER_API_KEY=
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# --- model registry ----------------------------------------------------------
AGRI_MODEL_REGISTRY=models/registry
AGRI_CONFIG_DIR=configs
AGRI_STRICT_MODELS=false             # true -> refuse to start if a module cannot load
